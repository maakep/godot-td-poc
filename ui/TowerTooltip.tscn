[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/tower_tooltip.gd" id="1_tooltip"]

[node name="TowerTooltip" type="MarginContainer"]
custom_minimum_size = Vector2(260, 0)
mouse_filter = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 6
script = ExtResource("1_tooltip")

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 6

[node name="Name" type="Label" parent="VBoxContainer"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(1, 0.84, 0.3, 1)
theme_override_font_sizes/font_size = 18
text = "Tower"

[node name="Description" type="Label" parent="VBoxContainer"]
layout_mode = 2
modulate = Color(0.82, 0.85, 0.9, 1)
mouse_filter = 2
text = "Tower description"
autowrap_mode = 2

[node name="Separator" type="HSeparator" parent="VBoxContainer"]
layout_mode = 2
mouse_filter = 2

[node name="Stats" type="GridContainer" parent="VBoxContainer"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/h_separation = 24
theme_override_constants/v_separation = 3
columns = 2
